# GitHub Token (Optional but highly recommended to avoid 60 req/hr rate limits)
# Create a fine-grained or classic PAT with read-only public access
GITHUB_TOKEN=

# PostgreSQL Database Configuration
POSTGRES_DB=github_events
POSTGRES_USER=github_pipeline
POSTGRES_PASSWORD=change-this-to-a-long-random-secret
POSTGRES_PORT=5432

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=github-events

# Streaming & Polling Configuration
POLL_INTERVAL_SECONDS=10
DEDUP_CACHE_SIZE=10000
KAFKA_DELIVERY_TIMEOUT_SECONDS=30
SPARK_WINDOW_DURATION=5 minutes
SPARK_SLIDE_DURATION=1 minute
SPARK_WATERMARK_DURATION=10 minutes
SPARK_CHECKPOINT_DIR=/checkpoints/github-events
KAFKA_STARTING_OFFSETS=latest
KAFKA_FAIL_ON_DATA_LOSS=true
